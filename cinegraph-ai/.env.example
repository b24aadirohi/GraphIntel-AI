# Run python scripts/configure.py --local to generate private secrets.
CINEGRAPH_ENV=development
CINEGRAPH_REQUIRE_AUTH=true
CINEGRAPH_API_KEY=
REDIS_URL=redis://localhost:6388/0
SEED_SAMPLE_DATA=true
# Local demonstration credentials only; replace before sharing a deployment.
POSTGRES_PASSWORD=cinegraph-local-password
NEO4J_PASSWORD=cinegraph-local-password
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,catalog
# Native Python clients connect to Compose databases using these host ports.
DATABASE_URL=postgresql://cinegraph:cinegraph-local-password@localhost:5544/cinegraph
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
API_BASE_URL=http://localhost:8100
CATALOG_URL=http://localhost:8101/admin/
# Empty API key keeps chat in clearly labelled evidence-only mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_AUTH_HEADER=Authorization
